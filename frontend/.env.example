# Copy to .env.local and fill in. All values are public (bundled into the client).

# API base path. Defaults to /api (same-origin Vercel Functions) when unset.
# For local dev against the mock API: http://localhost:8787
VITE_API_BASE_URL=/api

# Supabase project settings (Project Settings > API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# Skip Supabase and use a fake signed-in session (Playwright E2E, offline dev)
# VITE_AUTH_BYPASS=true
